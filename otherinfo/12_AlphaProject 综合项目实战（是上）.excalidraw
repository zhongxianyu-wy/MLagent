,"elbowed":false,"fillStyle":"solid","strokeWidth":2,"version":828,"roundness":{"type":2},"type":"arrow","updated":1779191788182,"id":"tiNnPWJ--Ru7HMsJWg2HB","x":1781.1003991539883,"seed":792941479,"boundElements":[],"y":3536.5676587078224,"opacity":100,"height":66.85533231961108,"points":[[0,0],[-4.9879874855328126,66.85533231961108]],"width":4.9879874855328126,"frameId":null,"strokeStyle":"solid","versionNonce":499995175},{"isDeleted":false,"locked":false,"strokeColor":"#1e1e1e","link":null,"endArrowhead":"arrow","roughness":1,"groupIds":["Bz6PaIYtmstrToORFxKUY","sL6-w7kfQz8aXCm6_-EcE","7Wm2j7dp5KhZJzZvyajBN"],"startBinding":null,"index":"b9e","startArrowhead":null,"backgroundColor":"transparent","endBinding":null,"angle":0,"elbowed":false,"fillStyle":"solid","strokeWidth":2,"version":766,"roundness":{"type":2},"type":"arrow","updated":1779191788182,"id":"6IxDTFwsEt3XZF3rmnXKY","x":1783.1093229422659,"seed":1631686215,"boundElements":[],"y":3696.5840187879166,"opacity":100,"height":62.890612186200542,"points":[[0,0],[-4.6647758017929846,62.890612186200542]],"width":4.6647758017929846,"frameId":null,"strokeStyle":"solid","versionNonce":80639303},{"isDeleted":false,"locked":false,"strokeColor":"#2f9e44","link":null,"roughness":1,"groupIds":["7Wm2j7dp5KhZJzZvyajBN"],"index":"b9f","backgroundColor":"transparent","angle":0,"fillStyle":"solid","strokeWidth":2,"version":459,"roundness":{"type":3},"type":"rectangle","updated":1779191788182,"id":"C8L0_xBO7-ct5rQB5YM0i","x":614.81798706816471,"seed":1736789161,"boundElements":[],"y":2291.4169126961333,"opacity":100,"height":833.43629129032615,"width":1351.4905968414173,"frameId":null,"strokeStyle":"dotted","versionNonce":838743143},{"isDeleted":false,"locked":false,"strokeColor":"#f08c00","link":null,"roughness":1,"groupIds":["7Wm2j7dp5KhZJzZvyajBN"],"index":"b9g","backgroundColor":"transparent","angle":0,"fillStyle":"solid","strokeWidth":2,"version":641,"roundness":{"type":3},"type":"rectangle","updated":1779191788182,"id":"WQNNkiO9e4Du4GsKkc0pv","x":616.81645960735295,"seed":1999114409,"boundElements":[],"y":3128.1700406090899,"opacity":100,"height":791.0533274225977,"width":1351.4905968414173,"frameId":null,"strokeStyle":"dotted","versionNonce":489230215},{"isDeleted":false,"locked":false,"strokeColor":"#f08c00","link":null,"roughness":1,"groupIds":["7Wm2j7dp5KhZJzZvyajBN"],"index":"b9h","backgroundColor":"transparent","angle":0,"fillStyle":"hachure","strokeWidth":2,"version":420,"roundness":{"type":3},"type":"rectangle","updated":1779191788182,"id":"EDFjdX9HLsAlgn9QpI034","x":-5.1137108048259279,"seed":1739373991,"boundElements":[{"type":"text","id":"1yO_hYQljBglhZUXg45uY"}],"y":2302.42420077324,"opacity":100,"height":1611.8085053190975,"width":297.38006433394582,"frameId":null,"strokeStyle":"solid","versionNonce":277579431},{"seed":1492013607,"strokeStyle":"solid","id":"1yO_hYQljBglhZUXg45uY","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":36,"opacity":100,"verticalAlign":"middle","updated":1779191788182,"locked":false,"text":"调研","version":114,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b9i","roundness":null,"containerId":"EDFjdX9HLsAlgn9QpI034","originalText":"调研","height":45,"link":null,"strokeColor":"#f08c00","fillStyle":"hachure","groupIds":["7Wm2j7dp5KhZJzZvyajBN"],"versionNonce":1523718599,"textAlign":"center","fontFamily":5,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":107.57632136214693,"angle":0,"y":3085.8284534327886,"width":72},{"isDeleted":false,"locked":false,"strokeColor":"#1e1e1e","link":null,"roughness":1,"groupIds":["7Wm2j7dp5KhZJzZvyajBN"],"index":"b9j","backgroundColor":"transparent","angle":0,"fillStyle":"hachure","strokeWidth":2,"version":296,"roundness":{"type":3},"type":"rectangle","updated":1779191788182,"id":"MS03SGKPY10e6FiedEd0I","x":-45.176559998439643,"seed":1253527495,"boundElements":[],"y":2255.9520734261919,"opacity":100,"height":1713.959718779688,"width":2163.4252653628291,"frameId":null,"strokeStyle":"solid","versionNonce":1092176103},{"isDeleted":false,"locked":false,"strokeColor":"#1e1e1e","link":null,"roughness":1,"groupIds":[],"index":"b9z","backgroundColor":"transparent","angle":0,"fillStyle":"hachure","strokeWidth":2,"version":413,"roundness":{"type":3},"type":"rectangle","updated":1779191798452,"id":"yrvbZSjdZO8wE947ZLYjN","x":3491.8662058429036,"seed":2044959399,"boundElements":[{"type":"text","id":"TkON3mBryCEP6urVrMkJL"}],"y":2447.8136232326979,"opacity":100,"height":2635,"width":1042.8890215331048,"frameId":null,"strokeStyle":"solid","versionNonce":1559027559},{"seed":1831916777,"strokeStyle":"solid","id":"TkON3mBryCEP6urVrMkJL","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"middle","updated":1779191798452,"locked":false,"text":" # 调研任务：A 股自动盯盘 AI 助手 · 产品立项调研\n\n ## 项目定位\n\n 7×24 帮我盯 A 股的 AI 助手：自选股 Dashboard + 自然语言智能选股 + 每日早盘简报 + 异动预警\n\n\n ## 📁 调研文件输出路径\n\n `<当前项目目录>\/specs\/research\/`\n\n  ```\n  research\/\n  ├── 01-产品形态.md\n  ├── 02-数据来源.md\n  ├── 03-开源项目.md\n  ├── 04-实现方案.md\n  └── 05-决策汇总.md\n  ```\n\n ## 调研主题 1：产品形态\n\n需要回答这些问题，每个都要给可视的证据（截图描述 \/ 链接 \/ 真实产品名）：\n\n  1. 同类产品盘点：A 股看盘\/盯盘\/选股类，主流产品有哪些？（中国市场为主，至少 10 个）\n  2. 信息架构：他们首页长什么样？主导航有哪些？自选股、行情、推送各自怎么组织？\n  3. 交互模式：自选股管理、智能选股、异动推送，业内常见的交互套路是什么？\n  4. AI 化案例：已有的 AI 选股 \/ AI 盯盘产品（同花顺问财、AI 助手等），形态是什么？做到什么程度？\n  5. 推送形态：早盘简报 \/ 异动预警类，业内怎么呈现？（飞书卡片？公众号图文？APP push？）\n\n 产出：`01-产品形态.md` —— 产品全景图 + UI\/交互参考库 \n \n ## 调研主题 2：数据来源\n\n  1. 全市场盘点：A 股行情数据，能怎么拿？所有可行渠道列出来（开源、付费、券商接口、爬虫等）\n  2. 每个渠道的事实：\n     - 覆盖范围（A 股全量 \/ ETF \/ 港美股）\n     - 频率（日线 \/ 分钟 \/ Tick）\n     - 实时性（延迟几秒）\n     - 限频与配额\n     - 价格档位\n     - 注册门槛（身份证 \/ 信用卡 \/ 营业执照）\n     - 商用 \/ 二次分发的合规边界\n  3. 个人开发者主流选择：实际跑起来的开发者最常用哪几个？为什么？\n  4. 推荐方案：最推荐用什么 + 备用切换方案\n\n  产出：`02-数据来源.md` —— 数据源对照大表 + 推荐方案 + 风险点\n\n\n  ## 调研主题 3：开源项目\n\n  1. 可参考项目盘点：GitHub 上做同类事情的开源项目，至少找 10 个（关键词参考：股票\n  dashboard、A股监控、量化交易、自选股、stock alert 等）\n  2. 每个项目的事实：\n     - Star \/ 最近 commit \/ License\n     - 用什么技术栈\n     - 它做了什么（核心能力）\n     - 它没做什么（短板）\n     - 我能复用什么模块（数据接入？UI？回测？推送？）\n     - 集成难度（直接 fork \/ 拆出来用 \/ 仅参考）\n  3. 生态拼图：哪个项目擅长哪一块（数据接入用 A 项目，前端参考 B 项目，部署参考 C 项目）\n  4. 推荐组合：这个那边呢 我应该 fork \/ 借鉴哪几个？\n\n  产出：`03-开源项目.md` —— 项目清单 + 复用矩阵 + 初版本代码源建议\n\n \n  ## 调研主题 4：实现方案\n\n  把整套系统拆成 6 个模块，每个模块给业内主流方案 + 推荐：\n\n  | 模块 | 调研维度 |\n  |------|---------|\n  | 数据接入 | 接收 + 清洗 + 存储 的主流方案 |\n  | 存储层 | 历史行情存哪 \/ 实时数据缓存 \/ 用户数据 |\n  | 业务逻辑| 自选股管理 \/ 选股引擎 \/ 异动检测 \/ 简报生成 各自怎么实现 |\n  | 前端 UI| Web 框架 \/ 组件库 \/ 实时行情图表库 \/ 实时数据通信 |\n  | 推送通道 | 飞书 \/ 微信 \/ 钉钉 \/ Telegram，接入难度+成本 |\n  | 部署运维 | 本地 \/ 云服务器 \/ Serverless，每月预算估算 |\n\n  每个模块产出：\n  - 业内主流 2-3 个方案 + 各自优劣\n  - 推荐用什么 + 理由（要写出\"为什么不用 X\"）\n  - 大致工作量预估\n\n  产出：`04-实现方案.md` —— 6 个模块的方案对比 + 推荐技术栈组合 + 架构图（Mermaid）\n\n\n  ## 最终决策汇总\n\n  写一份 `05-决策汇总.md`：\n\n  1. 产品形态决策：长什么样（首页结构 + 功能形态）\n  2. 数据源决策：用什么 + 切换备份\n  3. 开源复用决策：fork \/ 借鉴哪几个项目\n  4. 技术栈决策：6 模块各自选什么\n  5. 架构总图：一张端到端架构图\n  6. 成本估算：每月预算\n  7. 风险：最该警惕的坑\n\n\n  ## 产出质量要求\n\n  1. 每个结论必须有事实支撑——链接 \/ 项目名 \/ 数据\n  2. 每个推荐必须给理由——\"为什么选 X，为什么不选 Y\"\n  3. 不知道就说不知道，不要瞎编","version":774,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"b9zV","roundness":null,"containerId":"yrvbZSjdZO8wE947ZLYjN","originalText":" # 调研任务：A 股自动盯盘 AI 助手 · 产品立项调研\n\n ## 项目定位\n\n 7×24 帮我盯 A 股的 AI 助手：自选股 Dashboard + 自然语言智能选股 + 每日早盘简报 + 异动预警\n\n\n ## 📁 调研文件输出路径\n\n `<当前项目目录>\/specs\/research\/`\n\n  ```\n  research\/\n  ├── 01-产品形态.md\n  ├── 02-数据来源.md\n  ├── 03-开源项目.md\n  ├── 04-实现方案.md\n  └── 05-决策汇总.md\n  ```\n\n ## 调研主题 1：产品形态\n\n需要回答这些问题，每个都要给可视的证据（截图描述 \/ 链接 \/ 真实产品名）：\n\n  1. 同类产品盘点：A 股看盘\/盯盘\/选股类，主流产品有哪些？（中国市场为主，至少 10 个）\n  2. 信息架构：他们首页长什么样？主导航有哪些？自选股、行情、推送各自怎么组织？\n  3. 交互模式：自选股管理、智能选股、异动推送，业内常见的交互套路是什么？\n  4. AI 化案例：已有的 AI 选股 \/ AI 盯盘产品（同花顺问财、AI 助手等），形态是什么？做到什么程度？\n  5. 推送形态：早盘简报 \/ 异动预警类，业内怎么呈现？（飞书卡片？公众号图文？APP push？）\n\n 产出：`01-产品形态.md` —— 产品全景图 + UI\/交互参考库 \n \n ## 调研主题 2：数据来源\n\n  1. 全市场盘点：A 股行情数据，能怎么拿？所有可行渠道列出来（开源、付费、券商接口、爬虫等）\n  2. 每个渠道的事实：\n     - 覆盖范围（A 股全量 \/ ETF \/ 港美股）\n     - 频率（日线 \/ 分钟 \/ Tick）\n     - 实时性（延迟几秒）\n     - 限频与配额\n     - 价格档位\n     - 注册门槛（身份证 \/ 信用卡 \/ 营业执照）\n     - 商用 \/ 二次分发的合规边界\n  3. 个人开发者主流选择：实际跑起来的开发者最常用哪几个？为什么？\n  4. 推荐方案：最推荐用什么 + 备用切换方案\n\n  产出：`02-数据来源.md` —— 数据源对照大表 + 推荐方案 + 风险点\n\n\n  ## 调研主题 3：开源项目\n\n  1. 可参考项目盘点：GitHub 上做同类事情的开源项目，至少找 10 个（关键词参考：股票\n  dashboard、A股监控、量化交易、自选股、stock alert 等）\n  2. 每个项目的事实：\n     - Star \/ 最近 commit \/ License\n     - 用什么技术栈\n     - 它做了什么（核心能力）\n     - 它没做什么（短板）\n     - 我能复用什么模块（数据接入？UI？回测？推送？）\n     - 集成难度（直接 fork \/ 拆出来用 \/ 仅参考）\n  3. 生态拼图：哪个项目擅长哪一块（数据接入用 A 项目，前端参考 B 项目，部署参考 C 项目）\n  4. 推荐组合：这个那边呢 我应该 fork \/ 借鉴哪几个？\n\n  产出：`03-开源项目.md` —— 项目清单 + 复用矩阵 + 初版本代码源建议\n\n \n  ## 调研主题 4：实现方案\n\n  把整套系统拆成 6 个模块，每个模块给业内主流方案 + 推荐：\n\n  | 模块 | 调研维度 |\n  |------|---------|\n  | 数据接入 | 接收 + 清洗 + 存储 的主流方案 |\n  | 存储层 | 历史行情存哪 \/ 实时数据缓存 \/ 用户数据 |\n  | 业务逻辑| 自选股管理 \/ 选股引擎 \/ 异动检测 \/ 简报生成 各自怎么实现 |\n  | 前端 UI| Web 框架 \/ 组件库 \/ 实时行情图表库 \/ 实时数据通信 |\n  | 推送通道 | 飞书 \/ 微信 \/ 钉钉 \/ Telegram，接入难度+成本 |\n  | 部署运维 | 本地 \/ 云服务器 \/ Serverless，每月预算估算 |\n\n  每个模块产出：\n  - 业内主流 2-3 个方案 + 各自优劣\n  - 推荐用什么 + 理由（要写出\"为什么不用 X\"）\n  - 大致工作量预估\n\n  产出：`04-实现方案.md` —— 6 个模块的方案对比 + 推荐技术栈组合 + 架构图（Mermaid）\n\n\n  ## 最终决策汇总\n\n  写一份 `05-决策汇总.md`：\n\n  1. 产品形态决策：长什么样（首页结构 + 功能形态）\n  2. 数据源决策：用什么 + 切换备份\n  3. 开源复用决策：fork \/ 借鉴哪几个项目\n  4. 技术栈决策：6 模块各自选什么\n  5. 架构总图：一张端到端架构图\n  6. 成本估算：每月预算\n  7. 风险：最该警惕的坑\n\n\n  ## 产出质量要求\n\n  1. 每个结论必须有事实支撑——链接 \/ 项目名 \/ 数据\n  2. 每个推荐必须给理由——\"为什么选 X，为什么不选 Y\"\n  3. 不知道就说不知道，不要瞎编","height":2625,"link":null,"strokeColor":"#1e1e1e","fillStyle":"hachure","groupIds":[],"versionNonce":1795840647,"textAlign":"left","fontFamily":5,"lineHeight":1.25,"frameId":null,"boundElements":[],"x":3496.8662058429036,"angle":0,"y":2452.8136232326979,"width":966.07989501953125},{"isDeleted":false,"locked":false,"strokeColor":"#1e1e1e","link":null,"roughness":1,"groupIds":[],"index":"bAB","backgroundColor":"transparent","angle":0,"fillStyle":"hachure","strokeWidth":2,"version":512,"roundness":{"type":3},"type":"rect