#!/usr/bin/env python3
"""Stop: git sync (commit+push) + distill nudge."""
import sys
import subprocess
from pathlib import Path

_PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_PLUGIN_ROOT))

from mlagent.hooks import read_hook_input, hook_output

data = read_hook_input()
cwd = Path(data.get("cwd", "."))
pm = cwd / "project_memory"
_bin = str(_PLUGIN_ROOT / "bin" / "mlagent")
parts = []

# git sync (commit + push)
if pm.exists():
    try:
        r = subprocess.run([_bin, "sync", "--memory-root", str(pm)], capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            parts.append("Memory synced to remote.")
        else:
            parts.append(f"Sync skipped: {r.stderr.strip()[:100]}")
    except Exception:
        parts.append("Sync skipped (non-blocking).")

parts.append("Session ending. If raw_memory has new entries with conclusions, consider distill-experience to precipitate into experience.")

hook_output("Stop", "\n\n".join(parts)[:10000])
