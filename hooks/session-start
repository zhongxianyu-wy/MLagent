#!/usr/bin/env python3
"""SessionStart: concise summary + git pull + memory status (progressive disclosure).

Injects a <300-char summary (not the full bootstrap SKILL.md). User can
invoke /mlagent:bootstrap on demand for the full workflow guide.
"""
import sys
import subprocess
from pathlib import Path

_PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_PLUGIN_ROOT))

from mlagent.hooks import read_hook_input, hook_output

data = read_hook_input()
cwd = Path(data.get("cwd", "."))
pm = cwd / "project_memory"
_bin = str(_PLUGIN_ROOT / "bin" / "mlagent")
parts = ["MLagent v0.3 loaded. Skills: explore-train / distill-experience / instance-to-sop / retrain-from-sop. Use /mlagent:bootstrap for the full workflow guide."]

# git pull (sync from remote)
if pm.exists():
    try:
        subprocess.run([_bin, "pull", "--memory-root", str(pm)], capture_output=True, text=True, timeout=30)
        parts.append("Memory synced from remote.")
    except Exception:
        pass

# memory status (if initialized)
if (pm / "project_profile" / "project.yaml").exists():
    try:
        r = subprocess.run([_bin, "status", "--memory-root", str(pm)], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            parts.append(r.stdout.strip())
    except Exception:
        pass

# try launch UI (detached, degrade gracefully)
if pm.exists():
    try:
        r = subprocess.run([_bin, "ui", "start", "--memory-root", str(pm)], capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            parts.append(r.stdout.strip())
    except Exception:
        parts.append("UI 启动失败（非阻塞）。")

hook_output("SessionStart", "\n".join(parts)[:2000])
